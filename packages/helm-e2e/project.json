{
  "name": "helm-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "packages/helm-e2e/src",
  "implicitDependencies": ["helm"],
  "targets": {
    "e2e": {
      "cache": false,
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/jest.preset.js",
        "{workspaceRoot}/tools/scripts/start-local-registry.ts",
        "{workspaceRoot}/tools/scripts/stop-local-registry.ts",
        "{workspaceRoot}/.github/workflows/ci.yml",
        "{workspaceRoot}/.nvmrc",
        {
          "externalDependencies": [
            "jest",
            "@nx/jest",
            "ts-jest",
            "testcontainers"
          ]
        }
      ],
      "options": {
        "passWithNoTests": true,
        "runInBand": true
      },
      "configurations": {
        "ci": {
          "ci": true,
          "coverage": true
        }
      }
    }
  }
}
